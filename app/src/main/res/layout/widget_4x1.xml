<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp">
        <LinearLayout android:id="@+id/date_box" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingEnd="6dp">
            <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="10/21" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/cq_w_ink"
                android:singleLine="true" />
            <TextView android:id="@+id/date_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="第 7 周 · 周三" android:textSize="8.5sp" android:textColor="@color/cq_w_ink3" android:singleLine="true" />
        </LinearLayout>
        <TextView android:layout_width="1dp" android:layout_height="22dp" android:background="@drawable/w_line" />
        <LinearLayout android:id="@+id/one_row" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="7dp" android:paddingEnd="5dp">
            <TextView android:id="@+id/one_chk" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="○" android:textSize="15sp" android:textColor="@color/cq_w_ink3"
                android:paddingEnd="6dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/one_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:singleLine="true" android:ellipsize="end" android:textSize="12sp"
                    android:text="读书论文(第八章)"
                    android:textColor="@color/cq_w_ink" />
                <TextView android:id="@+id/one_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:singleLine="true" android:ellipsize="end" android:textSize="8.5sp"
                    android:text="中国近现代史纲要 · 还有 3 件"
                    android:textColor="@color/cq_w_ink3" />
            </LinearLayout>
            <TextView android:id="@+id/one_chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/w_chip_danger" android:paddingStart="5dp" android:paddingEnd="5dp"
                android:paddingTop="1.5dp" android:paddingBottom="1.5dp" android:singleLine="true"
                android:text="逾期 2 天" android:textSize="8sp" android:textColor="@color/cq_w_danger"
                android:layout_marginStart="5dp" />
        </LinearLayout>
        <TextView android:layout_width="1dp" android:layout_height="22dp" android:background="@drawable/w_line" />
        <LinearLayout android:id="@+id/nx_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="9dp" android:gravity="center_vertical">
            <TextView android:id="@+id/nx_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="下一节 10:00" android:textSize="8.5sp" android:textColor="@color/cq_w_accent" android:singleLine="true" />
            <TextView android:id="@+id/nx_name" android:layout_width="72dp" android:layout_height="wrap_content"
                android:text="模拟电子技术 B座518" android:textSize="10sp" android:textColor="@color/cq_w_ink2"
                android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>