<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_bg"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="9dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/hd" android:text="待办 · 3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="9.5sp" android:letterSpacing="0.12"
            android:textColor="@color/cq_w_ink3" android:textStyle="bold" android:singleLine="true" />
        <TextView android:id="@+id/hd_sub" android:text="周三" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="9.5sp" android:textColor="@color/cq_w_ink3" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="3dp">
            <LinearLayout android:id="@+id/t1_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="2.5dp" android:paddingBottom="2.5dp">
                <TextView android:id="@+id/t1_chk" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="○" android:textSize="15sp" android:textColor="@color/cq_w_ink3"
                    android:paddingEnd="6dp" android:paddingStart="1dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/t1_title" android:text="读书论文(第八章)" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:singleLine="true" android:ellipsize="end" android:textSize="11sp"
                        android:textColor="@color/cq_w_ink" />
                    <TextView android:id="@+id/t1_sub" android:text="中国近现代史纲要" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:singleLine="true" android:ellipsize="end" android:textSize="9sp"
                        android:textColor="@color/cq_w_ink3" android:layout_marginTop="0.5dp" />
                </LinearLayout>
                <TextView android:id="@+id/t1_chip" android:text="逾期 2 天" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/w_chip_mute" android:paddingStart="5dp" android:paddingEnd="5dp"
                    android:paddingTop="1.5dp" android:paddingBottom="1.5dp" android:singleLine="true"
                    android:textSize="8.5sp" android:textColor="@color/cq_w_ink3" android:layout_marginStart="6dp" />
            </LinearLayout>            <LinearLayout android:id="@+id/t2_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="2.5dp" android:paddingBottom="2.5dp">
                <TextView android:id="@+id/t2_chk" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="○" android:textSize="15sp" android:textColor="@color/cq_w_ink3"
                    android:paddingEnd="6dp" android:paddingStart="1dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/t2_title" android:text="习题集 4(第四、五章)" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:singleLine="true" android:ellipsize="end" android:textSize="11sp"
                        android:textColor="@color/cq_w_ink" />
                    <TextView android:id="@+id/t2_sub" android:text="概率论与数理统计A" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:singleLine="true" android:ellipsize="end" android:textSize="9sp"
                        android:textColor="@color/cq_w_ink3" android:layout_marginTop="0.5dp" />
                </LinearLayout>
                <TextView android:id="@+id/t2_chip" android:text="剩 17h" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/w_chip_mute" android:paddingStart="5dp" android:paddingEnd="5dp"
                    android:paddingTop="1.5dp" android:paddingBottom="1.5dp" android:singleLine="true"
                    android:textSize="8.5sp" android:textColor="@color/cq_w_ink3" android:layout_marginStart="6dp" />
            </LinearLayout>            <LinearLayout android:id="@+id/t3_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="2.5dp" android:paddingBottom="2.5dp">
                <TextView android:id="@+id/t3_chk" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="○" android:textSize="15sp" android:textColor="@color/cq_w_ink3"
                    android:paddingEnd="6dp" android:paddingStart="1dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/t3_title" android:text="第三章 搜索算法 课后习题" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:singleLine="true" android:ellipsize="end" android:textSize="11sp"
                        android:textColor="@color/cq_w_ink" />
                    <TextView android:id="@+id/t3_sub" android:text="人工智能基础及应用" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:singleLine="true" android:ellipsize="end" android:textSize="9sp"
                        android:textColor="@color/cq_w_ink3" android:layout_marginTop="0.5dp" />
                </LinearLayout>
                <TextView android:id="@+id/t3_chip" android:text="剩 1 天" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/w_chip_mute" android:paddingStart="5dp" android:paddingEnd="5dp"
                    android:paddingTop="1.5dp" android:paddingBottom="1.5dp" android:singleLine="true"
                    android:textSize="8.5sp" android:textColor="@color/cq_w_ink3" android:layout_marginStart="6dp" />
            </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="今天没有待办" android:textSize="10.5sp" android:textColor="@color/cq_w_ink3"
        android:visibility="gone" android:layout_marginTop="4dp" />
    <TextView android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@drawable/w_line" android:layout_marginTop="6dp" android:layout_marginBottom="5dp" />
    <LinearLayout android:id="@+id/nx_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/nx_time" android:text="下一节 10:00" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/cq_w_accent" android:singleLine="true" />
            <TextView android:id="@+id/nx_name" android:text="模拟电子技术" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="11sp" android:textColor="@color/cq_w_ink"
                android:singleLine="true" android:ellipsize="end" android:layout_marginStart="6dp" />
        </LinearLayout>
        <TextView android:id="@+id/nx_room" android:text="B座518 · 还剩 1 小时 12 分" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="8.5sp" android:textColor="@color/cq_w_ink3" android:singleLine="true" />
    </LinearLayout>
</LinearLayout>